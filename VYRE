local function closestTarget()
    local character = player.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local best, bestDistance = nil, math.huge
    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X/2,viewport.Y/2)

    for _,npc in ipairs(targets:GetChildren()) do
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local root = npc:FindFirstChild("HumanoidRootPart")

        if humanoid and humanoid.Health > 0 and root then
            local distance = (root.Position-myRoot.Position).Magnitude
            local point, visible = camera:WorldToViewportPoint(root.Position)
            local screenDistance = (Vector2.new(point.X,point.Y)-center).Magnitude

            if visible and distance <= maxDistance
                and (not fovEnabled or screenDistance <= fovRadius)
                and distance < bestDistance then
                best = root
                bestDistance = distance
            end
        end
    end

    return best
end

UIS.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        following = true
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        following = false
    end
end)

RunService.RenderStepped:Connect(function()
    circle.Visible = fovEnabled
    circle.Size = UDim2.fromOffset(fovRadius*2,fovRadius*2)

    if active and following then
        local target = closestTarget()
        if target then
            local goal = CFrame.lookAt(camera.CFrame.Position,target.Position)
            camera.CFrame = camera.CFrame:Lerp(goal,0.12)
        end
    end
end)

